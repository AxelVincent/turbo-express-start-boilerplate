# Infrastructure for docker-compose. The apps read their own env files —
# see apps/api/.env.example and apps/front/.env.example.
#
# Ports here are the HOST side of each mapping, so change them if something
# else is already listening. They must stay in sync with the matching values
# in the app env files (PGPORT, REDIS_PORT, LOKI_HOST, OTEL endpoint).

# PostgreSQL
PGHOST=localhost
PGPORT=5434
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=boilerplate

# Front — only used by the commented-out front service in docker-compose
FRONT_PORT=3005

# API — only used by the commented-out api service in docker-compose
API_PORT=3030

# Redis
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=redis_password

# Loki (log aggregation)
LOKI_PORT=3102

# Prometheus (metrics)
PROMETHEUS_PORT=9092

# Grafana (dashboards)
GRAFANA_PORT=3202

# Tempo (distributed traces)
TEMPO_PORT=3200
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_OTLP_GRPC_PORT=4317
