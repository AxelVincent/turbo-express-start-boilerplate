{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ES2015"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "@services/*": ["services/*"],
      "@external/*": ["external/*"],
      "@lib/*": ["lib/*"],
      "@queues/*": ["queues/*"]
    }
  },
  "exclude": ["node_modules", "tests", "src/**/__tests__", "src/routes_tests"],
  "include": ["src"]
}
