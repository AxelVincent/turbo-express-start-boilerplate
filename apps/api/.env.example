# API configuration
NODE_ENV='development'
PORT=3030
CORS_ORIGIN='*'
FRONTEND_BASE_URL='http://localhost:3005'
BASE_URL='http://localhost:3030'
LOG_LEVEL='debug'

# Database
PGHOST='localhost'
PGUSER='postgres'
PGPASSWORD='postgres'
PGDATABASE='boilerplate'
PGPORT='5434'
PGMIN='15'
PGMAX='90'
PG_PUBLIC_URL='postgresql://localhost:5434/boilerplate'

# Redis (background jobs, rate limiting)
REDIS_HOST='localhost'
REDIS_PORT=6379
REDIS_USER='default'
REDIS_PASSWORD='redis_password'

# Object storage (S3-compatible). Development uses the local filesystem
# provider and ignores these; every other NODE_ENV requires them.
# S3_ENDPOINT='https://s3.example.com'
# S3_BUCKET='your-bucket-name'
# S3_REGION='us-east-1'
# S3_ACCESS_KEY_ID='your-access-key'
# S3_SECRET_ACCESS_KEY='your-secret-key'

# Grafana
METRICS_USERNAME='metrics'
METRICS_PASSWORD='secure_password'
LOKI_HOST='http://localhost:3102'

# OpenTelemetry — traces exported to Tempo (see docker-compose).
# OTEL_SERVICE_NAME also labels this service's logs in Loki.
OTEL_EXPORTER_OTLP_ENDPOINT='http://localhost:4318'
OTEL_SERVICE_NAME='boilerplate-api'

# Better Auth
BETTER_AUTH_SECRET='your-secret-key-at-least-32-characters-long'

# Shared secret for /internal routes (requireInternalAuth). Routes 503 until
# this is set, so background workers must be given the same value.
INTERNAL_RPC_SECRET='change-me-at-least-32-characters-long'

# Slack (optional) — outside development every logger.error is posted here.
# Without a token the alert is logged instead, so this is safe to leave unset.
# SLACK_BOT_TOKEN='xoxb-...'
# SLACK_DEFAULT_CHANNEL='C0123456789'

# Resend (optional — emails are logged in dev without API key)
# RESEND_API_KEY=''
# EMAIL_FROM='noreply@example.com'

# Inbound email forwarding (optional). Mail to INBOUND_ADDRESS is received by
# Resend and forwarded to INBOUND_FORWARD_TO by /webhook/resend-inbound.
# Point the domain's MX records at Resend, create an inbound webhook aimed at
# <public-url>/webhook/resend-inbound, and paste the whsec_… signing secret it
# shows you. All four are required together — set none to leave it disabled.
# RESEND_INBOUND_WEBHOOK_SECRET='whsec_...'
# INBOUND_ADDRESS='contact@yourdomain.com'
# INBOUND_FORWARD_TO='team@yourdomain.com'
# INBOUND_FORWARD_FROM='forward@yourdomain.com'

# Google OAuth (optional — leave empty to disable)
# GOOGLE_CLIENT_ID=''
# GOOGLE_CLIENT_SECRET=''
